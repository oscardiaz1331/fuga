<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fuga_nav</name>
  <version>0.0.0</version>
  <description>Nav2 sobre el mapa de SLAM, con parametros ajustados al robot fuga</description>
  <maintainer email="oscardiaz1331@gmail.com">oscar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- navigation_launch.py y los servidores de Nav2 (ros-jazzy-navigation2) -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>navigation2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
